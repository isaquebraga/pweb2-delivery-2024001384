<div class="cabecalho">
  <h1>Entregas</h1>
  <a href="/entregas/nova" class="botao">Nova Entrega</a>
</div>

<form action="/entregas" method="GET" class="filtro">
  <label for="status">Status</label>
  <select id="status" name="status">
    <option value="">Todos</option>
    <% statusDisponiveis.forEach((status) => { %>
      <option value="<%= status %>" <%= status === filtro ? 'selected' : '' %>><%= status %></option>
    <% }) %>
  </select>
  <button type="submit" class="botao botao-secundario">Filtrar</button>
</form>

<% if (entregas.length === 0) { %>
  <p class="vazio">Nenhuma entrega encontrada.</p>
<% } else { %>
  <table>
    <thead>
      <tr>
        <th>#</th>
        <th>Descrição</th>
        <th>Origem</th>
        <th>Destino</th>
        <th>Status</th>
      </tr>
    </thead>
    <tbody>
      <% entregas.forEach((entrega) => { %>
        <tr>
          <td><%= entrega.id %></td>
          <td><a href="/entregas/<%= entrega.id %>"><%= entrega.descricao %></a></td>
          <td><%= entrega.origem %></td>
          <td><%= entrega.destino %></td>
          <td><%- include('../partials/status', { status: entrega.status }) %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>
